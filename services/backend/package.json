{
  "name": "@manatees/backend",
  "version": "0.1.0",
  "description": "WIP",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamhamlin/manatees.git"
  },
  "author": "Adam C Hamlin <achamlin@gmail.com>",
  "scripts": {
    "build-shared": "npm run build --prefix ../shared",
    "prestart": "npm run build-shared",
    "start": "TS_NODE_FILES=true node ${MANATEES_SERVER_FLAGS:-} -r ts-node/register -r tsconfig-paths/register src/entrypoint.ts",
    "preclientDriver": "npm run build-shared",
    "clientDriver": "ts-node -r tsconfig-paths/register src/frontend/driver.ts",
    "generate": "prisma generate",
    "precompile": "npm run build-shared",
    "compile": "tsc -p ./",
    "check": "npm run compile",
    "watch": "npm run compile -- -watch",
    "pretest": "npm run build-shared",
    "test": "jest"
  },
  "prisma": {
    "seed": "ts-node prisma/seed/index.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/websocket": "^11.2.0",
    "@manatees/shared": "*",
    "@prisma/client": "^6.19.0",
    "@types/stream-chain": "^2.1.0",
    "@types/stream-json": "^1.7.8",
    "axios": "^1.13.2",
    "dayjs": "^1.11.19",
    "deep-equality-data-structures": "^2.0.0",
    "fastify-esso": "^1.3.5",
    "fastify-type-provider-zod": "^6.1.0",
    "openid-client": "^6.8.8",
    "pluralize": "^8.0.0",
    "radashi": "^12.7.1",
    "stream-chain": "^3.4.0",
    "stream-json": "^1.9.1",
    "super-simple-fastify-server": "^1.0.0",
    "ts-pattern": "^5.9.0",
    "zod": "^4.1.13",
    "zod-prisma-types": "^3.3.10"
  },
  "devDependencies": {
    "@tsconfig/recommended": "^1.0.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/pluralize": "^0.0.33",
    "@types/ws": "^8.18.1",
    "fastify": "^5.6.2",
    "jest": "^30.2.0",
    "prisma": "^6.19.0",
    "ts-jest": "^29.4.6",
    "tsconfig-paths": "^4.2.0"
  }
}
